# Server Configuration
# Port the HTTP API listens on
PORT=3001
# Runtime environment: development | production | test
NODE_ENV=development

# Database Configuration
# Full MongoDB connection string. A replica set is required because the API
# relies on replica-set features. For a local single-node replica set use:
# mongodb://localhost:27017/repository_reid?replicaSet=rs0
MONGODB_URI=mongodb://localhost:27017/repository_reid?replicaSet=rs0

# API Configuration
# Shared secret required on every request via the "x-api-key" header
# (or "Authorization: Bearer <key>"). Generate a strong random value.
API_KEY=change-me-to-a-strong-random-secret

# Logging
# Log verbosity: error | warn | info | debug
LOG_LEVEL=info

# Similarity / Auto-merge (optional; sensible defaults applied if omitted)
# Max parallel workers for the background similarity processor (1-20)
SIMILARITY_MAX_WORKERS=5
# Enable automatic merging of persons whose embeddings are highly similar
AUTO_MERGE_ENABLED=true
# Cosine-similarity threshold for auto-merge (0.4 - 1.0)
AUTO_MERGE_THRESHOLD=0.6
# Optional webhook URL notified when an auto-merge happens. Empty disables it.
MERGE_WEBHOOK_URL=
